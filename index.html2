<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Calculadora Acumulativa</title>
</head>
<body>

    <h2>Calculadora</h2>

    <input type="number" id="num1" placeholder="Número 1">
    <input type="number" id="num2" placeholder="Número 2">

    <br><br>

    <button onclick="adição()">+</button>
    <button onclick="subtração()">-</button>
    <button onclick="multiplicação()">*</button>
    <button onclick="divisão()">/</button>
    <button onclick="limpatudo()">Limpar</button>

    <br><br>

    <div id="resultado">Resultado: </div>

    <script>
        function Attprox(resu) {
            document.getElementById("resultado").innerText = "Resultado: " + resu;
            document.getElementById("num1").value = resu;
            document.getElementById("num2").value = "";
            document.getElementById("num2").focus();
        }

        function adição() {
            let n1 = Number(document.getElementById("num1").value);
            let n2 = Number(document.getElementById("num2").value);
            let res = n1 + n2;
  
           Attprox(res);
        }

        function subtração() {
            let n1 = Number(document.getElementById("num1").value);
            let n2 = Number(document.getElementById("num2").value);
            let res = n1 - n2;
            
            Attprox(res);
        }

        function multiplicação() {
            let n1 = Number(document.getElementById("num1").value);
            let n2 = Number(document.getElementById("num2").value);
            let res = n1 * n2;
            
            Attprox(res);
        }

        function divisão() {
            let n1 = Number(document.getElementById("num1").value);
            let n2 = Number(document.getElementById("num2").value);
            
            if (n2 === 0) {
                document.getElementById("resultado").innerText = "E dividir por zero existe?";
            } else {
                let res = n1 / n2;
                Attprox(res);
            }
        }

        function limpatudo() {
            document.getElementById("num1").value = "";
            document.getElementById("num2").value = "";
            document.getElementById("resultado").innerText = "Resultado: ";
            document.getElementById("num1").focus();
        }
    </script>

</body>
</html>
